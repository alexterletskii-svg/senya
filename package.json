{
  "name": "senya",
  "version": "0.1.0",
  "description": "Сеня — цифровой напарник на рабочем столе: перерывы, разминки, Pomodoro, дела",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.senya.app",
    "productName": "Сеня",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "productName": "Senya"
}
